# deploy-bump: 2026-08-07T16:40:07Z - force redeploy to populate HASS_TOKEN from secret
services:
  hermes-gateway:
    # SHTF: image is mirrored into the local Forgejo registry (see .forgejo/workflows/mirror-hermes.yml)
    image: <REDACTED_HOST>/nicholas/hermes-agent:main
    container_name: hermes-gateway
    command: ["hermes", "gateway", "run"]
    restart: unless-stopped
    # SHTF: don't depend on registry reachability for restarts
    pull_policy: if_not_present
    # Hermes image rejects `--user`; run as root and pass host UID/GID so files
    # land owned by the host user (PUID/PGID aliases are supported).
    environment:
      PUID: 1000
      PGID: 1000
      HERMES_HOME: /data
      HERMES_PROFILE: default
      # Local-only stack: Ollama on Windows desktop + HAOS
      OLLAMA_BASE_URL: ${OLLAMA_BASE_URL}
      HASS_URL: ${HASS_URL}
      HASS_TOKEN: ${HASS_TOKEN}
      # API server for local WebUI / desktop app / HA integrations
      API_SERVER_ENABLED: "true"
      API_SERVER_HOST: "0.0.0.0"
      API_SERVER_PORT: "8642"
      API_SERVER_KEY: ${HERMES_API_KEY}
      API_SERVER_CORS_ORIGINS: "[\"https://<REDACTED_HOST>\",\"http://<REDACTED_IP>:3000\",\"http://<REDACTED_IP>\",\"https://<REDACTED_HOST>\"]"
    # The image's s6 supervisor already runs the gateway (`main-hermes`
    # service) and dashboard. Do NOT override `command` with a second
    # `hermes gateway run` — that spawns an orphan dispatcher that refuses
    # to start (profile lock) and crash-loops the container. Let s6 manage it.
    volumes:
      - hermes-data:/data
    networks:
      - aiproxy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.hermes-api.rule=Host(`${HERMES_PUBLIC_URL}`) && PathPrefix(`/api`)"
      - "traefik.http.routers.hermes-api.entrypoints=websecure"
      - "traefik.http.routers.hermes-api.tls=true"
      - "traefik.http.routers.hermes-api.tls.certresolver=${CERTRESOLVER}"
      - "traefik.http.routers.hermes-api.tls.domains[0].main=${HERMES_PUBLIC_URL}"
      - "traefik.http.routers.hermes-api.middlewares=lan-only"
      - "traefik.http.routers.hermes-v1.rule=Host(`<REDACTED_HOST>`) && PathPrefix(`/v1`)"
      - "traefik.http.routers.hermes-v1.entrypoints=websecure"
      - "traefik.http.routers.hermes-v1.tls=true"
      - "traefik.http.routers.hermes-v1.tls.certresolver=cloudflare"
      - "traefik.http.routers.hermes-v1.tls.domains[0].main=<REDACTED_HOST>"
      - "traefik.http.routers.hermes-v1.middlewares=lan-only"
      - "traefik.http.services.hermes-api.loadbalancer.server.port=8642"
      - "traefik.http.routers.hermes-gateway.rule=Host(`${HERMES_PUBLIC_URL}`) && PathPrefix(`/ws`)"
      - "traefik.http.routers.hermes-gateway.entrypoints=websecure"
      - "traefik.http.routers.hermes-gateway.tls=true"
      - "traefik.http.routers.hermes-gateway.tls.certresolver=${CERTRESOLVER}"
      - "traefik.http.routers.hermes-gateway.tls.domains[0].main=${HERMES_PUBLIC_URL}"
      - "traefik.http.routers.hermes-gateway.middlewares=lan-only"
      - "traefik.http.services.hermes-gateway.loadbalancer.server.port=8642"
      - "ha.monitor=true"
      - "ha.category=automation"
      - "ha.compose-file=Docker-NonCritical/Automation/AI/Hermes/hermes.yml"
      - "ha.service-name=hermes-gateway"

  hermes-dashboard:
    image: <REDACTED_HOST>/nicholas/hermes-agent:main
    container_name: hermes-dashboard
    restart: unless-stopped
    # SHTF: don't depend on registry reachability for restarts
    pull_policy: if_not_present
    # Hermes image rejects `--user`; run as root and pass host UID/GID so files
    # land owned by the host user (PUID/PGID aliases are supported).
    environment:
      PUID: 1000
      PGID: 1000
      HERMES_HOME: /data
      HERMES_PROFILE: default
      OLLAMA_BASE_URL: ${OLLAMA_BASE_URL}
      HERMES_DASHBOARD_HOST: "0.0.0.0"
      HERMES_DASHBOARD_PORT: "9119"
      HERMES_DASHBOARD_PUBLIC_URL: "https://${HERMES_PUBLIC_URL}"
      # Dashboard authenticates to the gateway API server (HERMES_API_KEY must equal gateway API_SERVER_KEY).
      HERMES_API_KEY: "${HERMES_API_KEY}"
      # Required so the dashboard may bind 0.0.0.0 (non-loopback) — the auth
      # gate refuses a public bind with no registered provider. Authentik sits
      # in front at the edge; this is the second factor. Username is fixed;
      # the hash comes from a repo secret (HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH).
      HERMES_DASHBOARD_BASIC_AUTH_USERNAME: "hermes"
      HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH: "${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH}"
      HERMES_DASHBOARD_BASIC_AUTH_SECRET: "${HERMES_DASHBOARD_BASIC_AUTH_SECRET}"
    volumes:
      - hermes-data:/data
    networks:
      - aiproxy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.hermes-dashboard.rule=Host(`${HERMES_PUBLIC_URL}`)"
      - "traefik.http.routers.hermes-dashboard.entrypoints=websecure"
      - "traefik.http.routers.hermes-dashboard.tls=true"
      - "traefik.http.routers.hermes-dashboard.tls.certresolver=${CERTRESOLVER}"
      - "traefik.http.routers.hermes-dashboard.tls.domains[0].main=${HERMES_PUBLIC_URL}"
      - "traefik.http.routers.hermes-dashboard.middlewares=lan-only"
      - "traefik.http.services.hermes-dashboard.loadbalancer.server.port=9119"
      - "ha.monitor=true"
      - "ha.category=automation"
      - "ha.compose-file=Docker-NonCritical/Automation/AI/Hermes/hermes.yml"
      - "ha.service-name=hermes-dashboard"
    # Bind 0.0.0.0 so Traefik (on the aiproxy network) can reach it; the
    # lan-only (IP allowlist) + dashboard basic-auth protect it at the edge; Authentik outpost not provisioned on <REDACTED_HOST>, so hermes uses local auth (SHTF/local-first).
    # was unreachable from Traefik -> dashboard 404/000 behind the proxy.)
    command: >-
      hermes dashboard --host 0.0.0.0 --port 9119 --skip-build
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://127.0.0.1:9119/health || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3

volumes:
  hermes-data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: /srv/hermes

networks:
  aiproxy:
    external: true
